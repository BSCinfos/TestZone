
/* =========================================================
   BSCINFOS - ESTILIZAÇÃO POR PLATAFORMA
   PC / TABLET / CELULAR
   ========================================================= */

:root {
    --platform-main-width: 1400px;
    --platform-main-padding: 30px;
    --platform-sidebar-width: 280px;
    --platform-gap: 25px;
    --platform-card-padding: 20px;
    --platform-font-scale: 1;
}

/* Seletor de plataforma */
.platform-switcher {
    position: fixed;
    top: 55px;
    right: 14px;
    z-index: 100000;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    background: rgba(17,18,23,.96);
    border: 1px solid var(--borda-destaque, #2a2a35);
    border-radius: 9px;
    box-shadow: 0 6px 22px rgba(0,0,0,.35);
    backdrop-filter: blur(8px);
}

.platform-switcher-label {
    color: var(--texto-secundario, #aaa);
    font-size: 10px;
    font-weight: 900;
    padding: 0 5px;
    text-transform: uppercase;
}

.platform-switch-btn {
    border: 1px solid transparent;
    background: transparent;
    color: var(--texto, #fff);
    border-radius: 6px;
    padding: 6px 9px;
    font-size: 10px;
    font-weight: 900;
    cursor: pointer;
    text-transform: uppercase;
    transition: .18s ease;
}

.platform-switch-btn:hover {
    border-color: var(--accent-purple, #d3d3d3);
}

.platform-switch-btn.active {
    background: var(--accent-purple, #d3d3d3);
    color: #111;
    border-color: var(--accent-purple, #d3d3d3);
}

/* Variáveis de cada plataforma */
html[data-platform="pc"] {
    --platform-main-width: 1400px;
    --platform-main-padding: 30px;
    --platform-sidebar-width: 280px;
    --platform-gap: 25px;
    --platform-card-padding: 20px;
    --platform-font-scale: 1;
}

html[data-platform="tablet"] {
    --platform-main-width: 1080px;
    --platform-main-padding: 20px;
    --platform-sidebar-width: 230px;
    --platform-gap: 18px;
    --platform-card-padding: 16px;
    --platform-font-scale: .96;
}

html[data-platform="mobile"] {
    --platform-main-width: 100%;
    --platform-main-padding: 10px;
    --platform-sidebar-width: 100%;
    --platform-gap: 12px;
    --platform-card-padding: 12px;
    --platform-font-scale: .91;
}

/* =========================================================
   PC
   ========================================================= */
html[data-platform="pc"] .main-container {
    max-width: var(--platform-main-width);
    padding: var(--platform-main-padding);
}

html[data-platform="pc"] .brawlers-container,
html[data-platform="pc"] .times-container {
    gap: var(--platform-gap);
}

html[data-platform="pc"] .sidebar {
    width: var(--platform-sidebar-width);
    min-width: var(--platform-sidebar-width);
}

html[data-platform="pc"] .info-panel {
    padding: 30px;
}

html[data-platform="pc"] .scrins-grid {
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
}

/* =========================================================
   TABLET
   ========================================================= */
html[data-platform="tablet"] body {
    overflow-x: hidden;
}

html[data-platform="tablet"] .main-container {
    width: 100%;
    max-width: var(--platform-main-width);
    padding: var(--platform-main-padding);
}

html[data-platform="tablet"] .navbar {
    padding-left: 125px;
    padding-right: 125px;
}

html[data-platform="tablet"] .brawlers-container,
html[data-platform="tablet"] .times-container {
    gap: var(--platform-gap);
}

html[data-platform="tablet"] .sidebar {
    width: var(--platform-sidebar-width);
    min-width: var(--platform-sidebar-width);
}

html[data-platform="tablet"] .info-panel {
    padding: var(--platform-card-padding);
}

html[data-platform="tablet"] .modo-card {
    font-size: 17px;
    padding: 16px;
}

html[data-platform="tablet"] .mapa-content {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
}

html[data-platform="tablet"] .scrins-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

html[data-platform="tablet"] .scrim-rounds-container {
    justify-content: flex-start;
}

/* =========================================================
   CELULAR
   ========================================================= */
html[data-platform="mobile"] {
    font-size: calc(16px * var(--platform-font-scale));
}

html[data-platform="mobile"] body {
    width: 100%;
    overflow-x: hidden;
}

html[data-platform="mobile"] .platform-switcher {
    top: auto;
    bottom: 10px;
    right: 10px;
    left: 10px;
    justify-content: center;
}

html[data-platform="mobile"] .platform-switcher-label {
    display: none;
}

html[data-platform="mobile"] .platform-switch-btn {
    flex: 1;
    padding: 8px 6px;
}

html[data-platform="mobile"] .navbar {
    width: 100%;
    padding: 12px 8px;
    overflow-x: auto;
    justify-content: flex-start;
}

html[data-platform="mobile"] .nav-links {
    width: max-content;
    gap: 12px;
    margin: 0 auto;
}

html[data-platform="mobile"] .nav-link {
    font-size: 11px;
    white-space: nowrap;
}

html[data-platform="mobile"] .main-container {
    width: 100%;
    max-width: 100%;
    padding: var(--platform-main-padding);
}

html[data-platform="mobile"] .page-header {
    margin-bottom: 18px;
}

html[data-platform="mobile"] .page-header h1 {
    font-size: 21px;
    line-height: 1.2;
}

html[data-platform="mobile"] .filter-container {
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
}

html[data-platform="mobile"] .filter-select {
    min-width: 0;
    flex: 1 1 45%;
    padding: 9px 10px;
    font-size: 11px;
}

html[data-platform="mobile"] .brawlers-container,
html[data-platform="mobile"] .times-container {
    height: auto;
    min-height: 0;
    width: 100%;
    flex-direction: column;
    gap: var(--platform-gap);
}

html[data-platform="mobile"] .sidebar {
    width: 100%;
    min-width: 0;
    height: 210px;
    max-height: 210px;
}

html[data-platform="mobile"] .sidebar-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 5px;
}

html[data-platform="mobile"] .sidebar-item {
    min-width: 0;
    padding: 8px;
    font-size: 11px;
}

html[data-platform="mobile"] .info-panel {
    width: 100%;
    min-width: 0;
    padding: var(--platform-card-padding);
    overflow: visible;
}

html[data-platform="mobile"] .modo-card {
    font-size: 15px;
    padding: 13px 10px;
    gap: 8px;
}

html[data-platform="mobile"] .modo-header {
    padding: 12px;
    font-size: 13px;
}

html[data-platform="mobile"] .mapa-content {
    padding: 10px;
    grid-template-columns: 1fr;
    gap: 10px;
}

html[data-platform="mobile"] .excel-table {
    display: block;
    overflow-x: auto;
    white-space: nowrap;
}

html[data-platform="mobile"] .synergy-grid {
    grid-template-columns: 1fr;
    gap: 10px;
}

html[data-platform="mobile"] .scrins-grid {
    grid-template-columns: 1fr;
}

html[data-platform="mobile"] .scrim-card {
    min-width: 0;
}

html[data-platform="mobile"] .scrim-rounds-container {
    justify-content: flex-start;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
}

html[data-platform="mobile"] .scrim-round-btn {
    min-width: 105px;
    flex: 0 0 auto;
}

html[data-platform="mobile"] .round-details-view {
    padding: 12px;
    gap: 12px;
}

html[data-platform="mobile"] .scrim-picks-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 15px;
}

html[data-platform="mobile"] .map-middle-scrim {
    order: -1;
}

html[data-platform="mobile"] .map-middle-scrim img {
    width: min(100%, 320px);
    max-width: 100%;
    height: auto;
}

html[data-platform="mobile"] .team-picks-scrim {
    width: 100%;
}

html[data-platform="mobile"] .pick-row img {
    width: 46px;
    height: 46px;
}

/* MAPAS - adaptação das telas existentes */
html[data-platform="mobile"] .mapas-layout {
    flex-direction: column;
    gap: 12px;
    min-height: 0;
}

html[data-platform="mobile"] #sidebar-mapas {
    width: 100%;
    min-width: 0;
    max-height: 230px;
}

html[data-platform="mobile"] #painel-info-mapa {
    width: 100%;
    min-width: 0;
}

/* Formulários */
html[data-platform="mobile"] .form-group input,
html[data-platform="mobile"] .form-group select,
html[data-platform="mobile"] .form-group textarea {
    width: 100%;
    max-width: 100%;
}

html[data-platform="mobile"] .modal-jogador-card {
    max-width: calc(100vw - 20px);
    padding: 18px;
}

/* Imagens nunca devem estourar a largura no celular */
html[data-platform="mobile"] img {
    max-width: 100%;
}

/* =========================================================
   AJUSTES GERAIS PARA COMPONENTES ESPECÍFICOS
   ========================================================= */
html[data-platform="tablet"] .platform-switcher {
    right: 10px;
}

.platform-transition,
.platform-transition * {
    transition: width .2s ease, max-width .2s ease, padding .2s ease,
                gap .2s ease, grid-template-columns .2s ease;
}

/* =========================================================
   NAVEGAÇÃO LATERAL GLOBAL
   Todas as antigas navbars superiores são ocultadas e
   substituídas por este menu lateral.
   ========================================================= */
:root {
    --side-nav-width: 250px;
    --side-nav-bg: #101116;
    --side-nav-border: #2b2d38;
    --side-nav-accent: #d000ff;
    --side-nav-text: #f5f5f7;
    --side-nav-muted: #9698a7;
}

.legacy-top-navbar {
    display: none !important;
}

body.has-side-navigation {
    padding-left: var(--side-nav-width);
    box-sizing: border-box;
}

.bsc-side-nav {
    position: fixed;
    z-index: 99990;
    top: 0;
    left: 0;
    bottom: 0;
    width: var(--side-nav-width);
    box-sizing: border-box;
    background: linear-gradient(180deg, #111217 0%, #0c0d11 100%);
    border-right: 1px solid var(--side-nav-border);
    box-shadow: 8px 0 28px rgba(0,0,0,.28);
    color: var(--side-nav-text);
}

.side-nav-header {
    height: 74px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 17px;
    border-bottom: 1px solid #272934;
    box-sizing: border-box;
}

.side-nav-brand {
    color: #fff;
    text-decoration: none;
    font-size: 23px;
    font-weight: 950;
    letter-spacing: -.7px;
}

.side-nav-brand strong { color: #fff; }
.side-nav-brand span { color: var(--side-nav-accent); }

.side-nav-close,
.side-nav-toggle {
    border: 0;
    cursor: pointer;
    color: #fff;
    background: #1a1b22;
}

.side-nav-close {
    display: none;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    font-size: 25px;
    line-height: 1;
}

.side-nav-scroll {
    height: calc(100vh - 74px);
    overflow-y: auto;
    padding: 12px 10px 20px;
    box-sizing: border-box;
    scrollbar-width: thin;
}

.side-nav-section {
    padding: 5px 0 13px;
    border-bottom: 1px solid rgba(255,255,255,.07);
    margin-bottom: 8px;
}

.side-nav-section-title {
    color: #777a8a;
    font-size: 10px;
    font-weight: 950;
    letter-spacing: .9px;
    padding: 8px 11px 7px;
    text-transform: uppercase;
}

.side-nav-link {
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 39px;
    box-sizing: border-box;
    padding: 8px 11px;
    margin: 2px 0;
    border-radius: 8px;
    color: #e9e9ee;
    text-decoration: none;
    font-size: 12px;
    font-weight: 850;
    letter-spacing: .15px;
    transition: background .16s ease, color .16s ease, transform .16s ease;
}

.side-nav-link:hover {
    background: #1c1d25;
    color: #fff;
    transform: translateX(2px);
}

.side-nav-link.active {
    background: linear-gradient(90deg, rgba(208,0,255,.22), rgba(208,0,255,.06));
    border-left: 3px solid var(--side-nav-accent);
    padding-left: 8px;
    color: #fff;
}

.side-region-link img {
    width: 22px;
    height: 22px;
    object-fit: contain;
    flex: 0 0 22px;
}

.side-screen-link {
    color: #c6c7d0;
}

.side-screen-link::before {
    content: "›";
    color: var(--side-nav-accent);
    font-size: 16px;
    line-height: 1;
}

.side-style-section {
    border-bottom: 0;
    padding-bottom: 8px;
}

.side-style-section .platform-switcher {
    position: static;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 5px;
    padding: 0;
    background: transparent;
    border: 0;
    box-shadow: none;
    backdrop-filter: none;
}

.side-style-section .platform-switch-btn {
    width: 100%;
    text-align: left;
    padding: 9px 11px;
    border: 1px solid #282a34;
    background: #17181e;
    color: #dfe0e7;
    border-radius: 8px;
    font-size: 10px;
}

.side-style-section .platform-switch-btn:hover {
    border-color: #9d00bd;
    background: #1d1e27;
}

.side-style-section .platform-switch-btn.active {
    background: var(--side-nav-accent);
    border-color: var(--side-nav-accent);
    color: #fff;
}

.side-nav-toggle {
    display: none;
    position: fixed;
    z-index: 100001;
    top: 12px;
    left: 12px;
    width: 44px;
    height: 44px;
    padding: 9px;
    border: 1px solid #333540;
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(0,0,0,.35);
}

.side-nav-toggle span {
    display: block;
    height: 2px;
    margin: 5px 0;
    background: #fff;
    border-radius: 2px;
}

.side-nav-backdrop {
    display: none;
}

/* O conteúdo das páginas continua responsivo, agora partindo da lateral. */
html[data-platform="pc"] {
    --side-nav-width: 250px;
}

html[data-platform="tablet"] {
    --side-nav-width: 220px;
}

html[data-platform="tablet"] body.has-side-navigation {
    padding-left: var(--side-nav-width);
}

html[data-platform="tablet"] .bsc-side-nav {
    width: var(--side-nav-width);
}

html[data-platform="mobile"] {
    --side-nav-width: 0px;
}

html[data-platform="mobile"] body.has-side-navigation {
    padding-left: 0;
}

html[data-platform="mobile"] .bsc-side-nav {
    width: 280px;
    max-width: 84vw;
    transform: translateX(-105%);
    transition: transform .22s ease;
}

html[data-platform="mobile"] body.side-nav-open .bsc-side-nav {
    transform: translateX(0);
}

html[data-platform="mobile"] .side-nav-toggle {
    display: block;
}

html[data-platform="mobile"] .side-nav-close {
    display: block;
}

html[data-platform="mobile"] .side-nav-backdrop {
    position: fixed;
    inset: 0;
    z-index: 99980;
    background: rgba(0,0,0,.65);
    backdrop-filter: blur(2px);
}

html[data-platform="mobile"] body.side-nav-open .side-nav-backdrop {
    display: block;
}

html[data-platform="mobile"] .side-nav-header {
    height: 65px;
}

html[data-platform="mobile"] .side-nav-scroll {
    height: calc(100vh - 65px);
}

html[data-platform="mobile"] .main-container {
    padding-top: 65px;
}

html[data-platform="mobile"] .wrapper,
html[data-platform="mobile"] .teams-wrapper,
html[data-platform="mobile"] .found-page {
    padding-top: 65px;
}

/* Tablet também usa uma lateral fixa, com tamanho reduzido. */
html[data-platform="tablet"] .side-nav-header {
    height: 68px;
}

html[data-platform="tablet"] .side-nav-scroll {
    height: calc(100vh - 68px);
}

/* Não deixar a antiga regra do switcher móvel voltar a colocá-lo no rodapé. */
html[data-platform="mobile"] .platform-switcher {
    position: static;
    left: auto;
    right: auto;
    bottom: auto;
    top: auto;
}

/* =========================================================
   OVERRIDES DA NOVA NAVBAR LATERAL
   Mantidos em CSS externo para não misturar estilo com HTML/JS.
   ========================================================= */
body.has-side-navigation {
    padding-left: var(--side-nav-width, 250px);
    transition: padding-left .22s ease;
}
body.has-side-navigation.side-nav-closed { padding-left: 0 !important; }

.bsc-side-nav {
    transform: translateX(0) !important;
    transition: transform .22s ease, width .22s ease !important;
}
body.side-nav-closed .bsc-side-nav { transform: translateX(-105%) !important; }

.side-nav-close {
    display: flex !important;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    border: 1px solid #30323d;
    border-radius: 8px;
    background: #191a21;
    color: #fff;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
}
.side-nav-close:hover { background: #d000ff; border-color: #d000ff; }

.side-nav-user {
    padding: 14px 16px 13px;
    border-bottom: 1px solid rgba(255,255,255,.07);
    background: rgba(255,255,255,.012);
}
.side-nav-user-label {
    display: block;
    margin-bottom: 5px;
    color: #777a8a;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 1px;
    text-transform: uppercase;
}
.side-nav-user-name {
    display: block;
    color: #fff;
    font-size: 14px;
    font-weight: 900;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.side-nav-user-name::before { content: '@'; color: #d000ff; margin-right: 2px; }

.side-nav-scroll { height: calc(100vh - 126px) !important; }

.side-style-section .platform-switcher {
    position: static !important;
    width: 100%;
    display: grid !important;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    padding: 0;
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
}
.side-style-section .platform-switch-btn {
    min-width: 0;
    min-height: 68px;
    padding: 7px 3px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border: 1px solid #292b35;
    border-radius: 9px;
    background: #17181e;
    color: #dfe0e7;
    cursor: pointer;
    font-size: 9px;
    font-weight: 900;
}
.side-style-section .platform-switch-btn img { width: 28px; height: 28px; object-fit: contain; opacity: .85; }
.side-style-section .platform-switch-btn:hover { border-color: #d000ff; background: #1d1e27; }
.side-style-section .platform-switch-btn.active { background: #d000ff; border-color: #d000ff; color: #fff; }
.side-style-section .platform-switch-btn.active img { opacity: 1; }

.side-nav-toggle {
    display: flex !important;
    position: fixed !important;
    z-index: 100001 !important;
    top: 12px;
    left: calc(var(--side-nav-width, 250px) - 54px);
    width: 42px;
    height: 42px;
    padding: 8px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    border: 1px solid #333540;
    border-radius: 10px;
    background: #1a1b22;
    box-shadow: 0 8px 24px rgba(0,0,0,.35);
    cursor: pointer;
    transition: left .22s ease, background .15s ease, border-color .15s ease;
}
body.side-nav-closed .side-nav-toggle { left: 12px; }
.side-nav-toggle:hover { background: #d000ff; border-color: #d000ff; }
.side-nav-toggle span { display: block; width: 20px; height: 2px; margin: 2px 0; background: #fff; border-radius: 2px; }

html[data-platform="pc"] { --side-nav-width: 250px; }
html[data-platform="tablet"] { --side-nav-width: 220px; }
html[data-platform="mobile"] { --side-nav-width: 280px; }

html[data-platform="mobile"] body.has-side-navigation { padding-left: 0 !important; }
html[data-platform="mobile"] .bsc-side-nav { width: min(280px, 86vw) !important; transform: translateX(-105%) !important; }
html[data-platform="mobile"] body.side-nav-open .bsc-side-nav { transform: translateX(0) !important; }
html[data-platform="mobile"] body.side-nav-open .side-nav-toggle { left: calc(min(280px, 86vw) - 54px); }
html[data-platform="mobile"] .side-nav-toggle { left: 12px; }
html[data-platform="mobile"] .side-nav-header { min-height: 65px; }
html[data-platform="mobile"] .side-nav-backdrop { display: none; }
html[data-platform="mobile"] body.side-nav-open .side-nav-backdrop { display: block; position: fixed; inset: 0; z-index: 99980; background: rgba(0,0,0,.65); backdrop-filter: blur(2px); }

html[data-platform="tablet"] body.has-side-navigation { padding-left: var(--side-nav-width); }
html[data-platform="tablet"] .bsc-side-nav { width: var(--side-nav-width) !important; }
html[data-platform="tablet"] .side-nav-header { min-height: 68px; }

body.side-nav-closed .side-nav-backdrop { display: none !important; }

/* =========================================================
   AVISO DO DRAFT NO CELULAR
   Aparece somente quando a interface CELULAR está selecionada
   e o aparelho está na vertical.
   ========================================================= */
.draft-mobile-warning {
    position: fixed;
    inset: 0;
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(5, 6, 10, .88);
    backdrop-filter: blur(7px);
}

.draft-mobile-warning.hidden {
    display: none;
}

.draft-mobile-warning-card {
    width: min(92vw, 430px);
    padding: 28px 24px;
    text-align: center;
    background: #111217;
    border: 1px solid #343542;
    border-radius: 18px;
    box-shadow: 0 20px 70px rgba(0, 0, 0, .65), 0 0 30px rgba(255, 0, 255, .12);
}

.draft-mobile-warning-icon {
    width: 58px;
    height: 58px;
    margin: 0 auto 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: linear-gradient(135deg, #ff00ff, #8800ff);
    color: #fff;
    font-size: 30px;
    font-weight: 900;
}

.draft-mobile-warning-card h2 {
    margin: 0 0 12px;
    color: #fff;
    font-size: 20px;
    font-weight: 900;
    text-transform: uppercase;
}

.draft-mobile-warning-card p {
    margin: 0 auto 22px;
    max-width: 360px;
    color: #c8c9d2;
    font-size: 14px;
    line-height: 1.55;
}

.draft-mobile-warning-close {
    border: 0;
    border-radius: 9px;
    padding: 11px 26px;
    background: linear-gradient(135deg, #ff00ff, #8800ff);
    color: #fff;
    font-size: 12px;
    font-weight: 900;
    cursor: pointer;
    text-transform: uppercase;
}

.draft-mobile-warning-close:hover {
    filter: brightness(1.12);
}

/* No celular em modo paisagem o Draft ocupa melhor a tela. */
html[data-platform="mobile"] body:has(.draft-mobile-warning) .draft-mobile-warning {
    display: flex;
}

@media (orientation: landscape) {
    .draft-mobile-warning {
        display: none !important;
    }
}
